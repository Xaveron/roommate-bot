# HTTPS for the Telegram Mini App. Caddy gets and renews the Let's Encrypt certificate
# by itself (ports 80 and 443 must be reachable). The domain comes from WEBAPP_DOMAIN in .env,
# e.g. 194-62-105-206.sslip.io (sslip.io resolves it to the IP inside the name).

{$WEBAPP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy webapp:8000
}
