# Token from @BotFather (required)
BOT_TOKEN=123456789:replace-with-your-token

# Database. SQLite file by default; for PostgreSQL (docker compose --profile postgres):
# DATABASE_URL=postgresql+asyncpg://roommate:roommate@postgres:5432/roommate
DATABASE_URL=sqlite+aiosqlite:///./data/roommate.db

# Production (docker-compose.prod.yml) only: password of the bundled PostgreSQL.
# DATABASE_URL above is ignored there. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Defaults for new rooms (each room can change them in /settings)
DEFAULT_TIMEZONE=Europe/Chisinau
DEFAULT_LANGUAGE=ru

# Telegram user ids of bot owners, comma-separated (enables /admin in private chat)
ADMIN_IDS=

LOG_LEVEL=INFO
# How often (seconds) the scheduler checks for due reminders
SCHEDULER_TICK_SECONDS=60
# Apply database migrations automatically on startup
AUTO_MIGRATE=true
